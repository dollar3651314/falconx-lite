# 测试环境的变量清单（S20，部署方案 v1.1 第 5 节）。只有变量名，没有值。
# 在服务器上：cp env.example .env && chmod 600 .env，然后由 Amos 填值（不发到对话里，不进仓库）。
# 密码类的值用部署方案第 6 节给的命令生成（只用字母和数字，不带换行）。

# ---- 域名（D2）和证书 ----
APP_DOMAIN=
ADMIN_DOMAIN=
# 官网（v2，例如 test-www.quickcome.online）；证书要包含这个域名（部署方案第 14 节）
WWW_DOMAIN=
# Let's Encrypt 证书快到期时的提醒邮箱
CERT_EMAIL=

# ---- 第一步就要填 ----
MYSQL_ROOT_PASSWORD=
FX_DB_PASSWORD=
FX_REDIS_PASSWORD=
# 第一个超级管理员（首次登录必须改密码；建好以后可以删掉这两行）
FX_ADMIN_INIT_USERNAME=
FX_ADMIN_INIT_PASSWORD=

# ---- 浏览器推送（测试环境单独一对，不能和生产共用）----
FX_PUSH_VAPID_PUBLIC_KEY=
FX_PUSH_VAPID_PRIVATE_KEY=
# mailto: 开头的联系邮箱
FX_PUSH_VAPID_SUBJECT=

# ---- 邮件（D3，服务商定了以后填；空着时邮件只写进日志）----
FX_MAIL_HOST=
FX_MAIL_PORT=587
# STARTTLS 或 SSL
FX_MAIL_SECURITY=STARTTLS
FX_MAIL_USERNAME=
FX_MAIL_PASSWORD=
FX_MAIL_FROM=

# ---- 风控告警收件人（H7，逗号分隔）----
FX_RISK_ALERT_EMAILS=

# ---- 监控告警收件人（v2 E8：行情断流、扫块停滞、链节点连不上、邮件连续失败；逗号分隔）----
# 默认 info@quickcome.online（Amos 2026-10-16 定的联系邮箱；H7 定了以后在这里改）。这一行删掉或空着时，docker-compose.yml 里也是这个默认值
FX_ALERT_EMAILS=info@quickcome.online

# ---- 雪花 ID 节点号（v2 第 11.4 节，0–1023）：单实例空着（默认 1）；以后多实例时每个实例填不同的值 ----
FX_ID_NODE=

# ---- 区块链（D4 第二步，全部用测试网；没配置的链不扫块）----
FX_WALLET_ETH_XPUB=
FX_WALLET_TRON_XPUB=
FX_WALLET_ETH_RPC_URL=
FX_WALLET_BSC_RPC_URL=
FX_WALLET_TRON_RPC_URL=
FX_WALLET_ERC20_USDT_CONTRACT=
FX_WALLET_BSC_USDT_CONTRACT=
FX_WALLET_TRC20_USDT_CONTRACT=
FX_WALLET_ETH_HOT_KEY=
FX_WALLET_TRON_HOT_KEY=
FX_WALLET_ETH_HOT_ADDRESS=
FX_WALLET_TRON_HOT_ADDRESS=

# ---- 真实报价源（v2，技术方案/v2-报价源接入.md；部署方案第 16 节）----
# token 只由 Amos 填。两个 token 都空着时和以前完全一样（全部模拟报价）；只填一家就只用这一家。
# 注意：两家条款都禁止未授权的再分发和公开展示。测试环境内部验收前先确认试用条款允许；生产必须先拿到书面授权
FX_QUOTE_ALLTICK_TOKEN=
FX_QUOTE_ITICK_TOKEN=
# 以下都有默认值，一般不用填：
# 地址（默认 wss://quote.alltick.co/quote-b-ws-api、wss://quote.alltick.co/quote-stock-b-ws-api、wss://api.itick.org）
FX_QUOTE_ALLTICK_FX_URL=
FX_QUOTE_ALLTICK_STOCK_URL=
FX_QUOTE_ITICK_URL=
# 主源 alltick 或 itick（默认 alltick）
FX_QUOTE_PRIMARY=
# 主源多久没报价切备源（默认 10s）、恢复多久后切回（默认 30s）、两家偏差阈值（默认 0.005 = 0.5%）
FX_QUOTE_FAILOVER_AFTER=
FX_QUOTE_FAILBACK_AFTER=
FX_QUOTE_MAX_DEVIATION=
# USDT 计价的加密货币乘的系数（默认 1，Amos 已确认 USDT 按 1:1 当 USD）
FX_QUOTE_USDT_USD_RATE=
# 官网公开行情用 simulated（默认，示例行情）还是 live（真实价）。拿到两家书面的公开展示授权以前不要改成 live
FX_PUBLIC_QUOTES_SOURCE=
