# 测试环境的变量清单（S20，部署方案 v1.1 第 5 节）。只有变量名，没有值。
# 在服务器上：cp env.example .env && chmod 600 .env，然后由 Amos 填值（不发到对话里，不进仓库）。
# 密码类的值用部署方案第 6 节给的命令生成（只用字母和数字，不带换行）。

# ---- 域名（D2）和证书 ----
APP_DOMAIN=
ADMIN_DOMAIN=
# Let's Encrypt 证书快到期时的提醒邮箱
CERT_EMAIL=

# ---- 第一步就要填 ----
MYSQL_ROOT_PASSWORD=
FX_DB_PASSWORD=
FX_REDIS_PASSWORD=
# 第一个超级管理员（首次登录必须改密码；建好以后可以删掉这两行）
FX_ADMIN_INIT_USERNAME=
FX_ADMIN_INIT_PASSWORD=

# ---- 浏览器推送（测试环境单独一对，不能和生产共用）----
FX_PUSH_VAPID_PUBLIC_KEY=
FX_PUSH_VAPID_PRIVATE_KEY=
# mailto: 开头的联系邮箱
FX_PUSH_VAPID_SUBJECT=

# ---- 邮件（D3，服务商定了以后填；空着时邮件只写进日志）----
FX_MAIL_HOST=
FX_MAIL_PORT=587
# STARTTLS 或 SSL
FX_MAIL_SECURITY=STARTTLS
FX_MAIL_USERNAME=
FX_MAIL_PASSWORD=
FX_MAIL_FROM=

# ---- 风控告警收件人（H7，逗号分隔）----
FX_RISK_ALERT_EMAILS=

# ---- 区块链（D4 第二步，全部用测试网；没配置的链不扫块）----
FX_WALLET_ETH_XPUB=
FX_WALLET_TRON_XPUB=
FX_WALLET_ETH_RPC_URL=
FX_WALLET_BSC_RPC_URL=
FX_WALLET_TRON_RPC_URL=
FX_WALLET_ERC20_USDT_CONTRACT=
FX_WALLET_BSC_USDT_CONTRACT=
FX_WALLET_TRC20_USDT_CONTRACT=
FX_WALLET_ETH_HOT_KEY=
FX_WALLET_TRON_HOT_KEY=
FX_WALLET_ETH_HOT_ADDRESS=
FX_WALLET_TRON_HOT_ADDRESS=
